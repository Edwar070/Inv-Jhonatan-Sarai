    padding: 3px 4px 3px 3px;
    gap: 5px;
  }

  .mp-cover-wrapper {
    width: 34px;
    height: 34px;
  }

  .mp-title {
    max-width: 75px;
    font-size: 0.68rem;
  }
  .mp-artist {
    max-width: 75px;
    font-size: 0.55rem;
  }
  .mp-btn {
    width: 30px;
    height: 30px;
  }
  .mp-icon {
    width: 13px;
    height: 13px;
  }

  .nota-confirmar {
    width: 90%;
    max-width: 270px;
    padding: 10px 12px;
    font-size: 0.68rem;
  }

  .nota-confirmar .firma {
    font-size: 0.64rem;
  }

  .footer-monogram svg {
    width: 70px;
    height: 70px;
  }
}

/* ============================================
   MÓVIL EN HORIZONTAL (landscape)
   ============================================ */
@media (max-height: 500px) and (orientation: landscape) {
  .hero {
    padding: 40px 20px 30px;
    min-height: 100vh;
  }

  .monogram svg {
    width: 90px;
    height: 90px;
  }

  .couple {
    font-size: 2.2rem;
  }

  .verse {
    font-size: 0.85rem;
    margin: 0.5rem 0;
  }

  .btn-gold {
    min-height: 36px;
    padding: 0.55rem 1.2rem;
  }

  .leaf-corner {
    width: 70px;
    height: 70px;
    opacity: 0.3;
  }
}

/* ============================================
   DISPOSITIVOS TÁCTILES (sin hover real)
   ACTUALIZADO: no agrandar botones, solo desactivar hover
   ============================================ */
@media (hover: none) and (pointer: coarse) {
  /* Desactivar hover transform en táctil (no agrandar botones) */
  .btn-gold:hover,
  .btn-outline:hover,
  .btn-wa:hover {
    transform: none;
  }

  /* Feedback táctil al presionar */
  .btn-gold:active,
  .btn-outline:active,
  .btn-wa:active {
    transform: scale(0.96);
    opacity: 0.9;
  }

  /* Cards de eventos sin hover en táctil */
  .event-card:hover {
    transform: none;
    box-shadow:
      0 10px 40px rgba(90, 107, 78, 0.08),
      0 2px 8px rgba(90, 107, 78, 0.04);
  }

  .swatch:hover {
    transform: none;
  }
}

