    max-width: 230px;
    letter-spacing: 1.2px;
  }

  .leaf-corner {
    width: 80px;
    height: 80px;
    opacity: 0.35;
  }

  .c-number {
    font-size: 1.25rem;
  }

  .c-box {
    padding: 0.5rem 0.15rem;
  }

  .c-item small {
    font-size: 0.5rem;
    letter-spacing: 0.5px;
  }

  .event-card {
    padding: 1.75rem 1.2rem;
  }

  .event-card h3 {
    font-size: 1.6rem;
  }

  .btn-outline {
    font-size: 0.58rem;
    padding: 0.45rem 1rem;
    min-height: 32px;
    max-width: 200px;
  }

  .btn-wa {
    font-size: 0.64rem;
    padding: 0.6rem 1.2rem;
    min-height: 38px;
    letter-spacing: 1.1px;
  }

