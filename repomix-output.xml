/* ============================================
   RESPONSIVE.CSS — Enfoque MOBILE-FIRST
   Invitación de Boda — Jonathan & Sarai
   Prioridad: 📱 Celular → Tablet → Desktop
   ============================================ */

/* ============================================
   BASE: CELULAR (Mobile-First)
   ============================================ */

/* --- Contenedor base --- */
.container {
  max-width: 100%;
  padding: 0 20px;
  margin: 0 auto;
}

/* --- HERO --- */
.hero {
  min-height: 100vh;
  min-height: 100dvh;
  padding: 70px 20px 60px;
}

.hero-inner {
  gap: 0.85rem;
  max-width: 100%;
}

.monogram svg {
  width: 120px;
  height: 120px;
}

.pretitle {
  font-size: 0.65rem;
  letter-spacing: 4px;
}

.couple {
  font-size: clamp(2.4rem, 11vw, 3.4rem);
  line-height: 1.1;
}

.couple .ampersand {
  font-size: clamp(1.8rem, 8vw, 2.6rem);
}

.hero-date {
  font-size: 0.85rem;
  letter-spacing: 4px;
}

.divider {
  max-width: 220px;
  margin: 0.75rem 0;
}

.verse {
  font-size: 0.95rem;
  line-height: 1.75;
  padding: 0 8px;
  margin: 0.75rem 0 1.5rem;
}

.verse cite {
  font-size: 0.8rem;
  margin-top: 0.4rem;
}

/* Botón principal — más pequeño y compacto */
.btn-gold {
  font-size: 0.68rem;
  padding: 0.65rem 1.4rem;
  min-height: 38px;
  width: auto;
  max-width: 260px;
  letter-spacing: 1.3px;
}

/* Ramas de esquina más pequeñas en móvil */
.leaf-corner {
  width: 100px;
  height: 100px;
  opacity: 0.45;
}

/* Ocultar el indicador de scroll en móvil (no es necesario) */
.scroll-indicator {
  display: none;
}

/* --- COUNTDOWN --- */
.countdown {
  padding: 4rem 20px;
}

.counter {
  gap: 0.4rem;
  margin: 2rem 0 1rem;
}

.c-number {
  font-size: clamp(1.4rem, 7vw, 2rem);
}

.c-box {
  padding: 0.6rem 0.2rem;
  border-radius: 10px;
}

.c-item small {
  font-size: 0.55rem;
  letter-spacing: 1px;
  margin-top: 0.4rem;
}

.date-line {
  font-size: 0.8rem;
  letter-spacing: 2px;
}

/* --- STORY --- */
.story {
  padding: 4rem 20px;
}

.story::before,
.story::after {
  width: 40px;
  height: 40px;
}

.story::before {
  top: 16px;
  left: 16px;
}
.story::after {
  bottom: 16px;
  right: 16px;
}

.story-text {
  font-size: 1rem;
  line-height: 1.9;
  padding: 0 4px;
}

.leaf-branch {
  max-width: 260px;
}

/* --- EVENTS --- */
.events {
  padding: 4rem 20px;
}

.event-grid {
  gap: 1.2rem;
  margin-top: 2rem;
}

.event-card {
  padding: 2rem 1.5rem;
}

.event-card h3 {
  font-size: 1.8rem;
}

.event-time {
  font-size: 1.4rem;
}

.event-place {
  font-size: 0.95rem;
}

/* Botón de ubicación — más pequeño */
.btn-outline {
  font-size: 0.62rem;
  padding: 0.5rem 1.2rem;
  min-height: 34px;
  width: 85%;
  max-width: 220px;
  letter-spacing: 1.2px;
}

/* --- DRESSCODE / GIFTS / RSVP --- */
.dresscode,
.gifts,
.rsvp {
  padding: 4rem 20px;
}

.dresscode-icon,
.gift-icon,
.wa-icon {
  width: 70px;
  height: 70px;
}

.dresscode-icon::after,
.gift-icon::after,
.wa-icon::after {
  inset: -6px;
}

.dresscode-text,
.gifts-text,
.rsvp-text {
  font-size: 1rem;
  line-height: 1.8;
}

.palette {
  padding: 1.25rem 1rem;
  max-width: 300px;
}

.swatch {
  width: 38px;
  height: 38px;
}

/* --- BOTÓN WHATSAPP --- */
.btn-wa {
  font-size: 0.68rem;
  padding: 0.65rem 1.4rem;
  min-height: 40px;
  letter-spacing: 1.2px;
  width: auto;
  max-width: 280px;
}

/* --- NOTA DE CONFIRMACIÓN --- */
.nota-confirmar {
  width: 88%;
  max-width: 290px;
  padding: 11px 14px;
  font-size: 0.72rem;
  margin: 15px auto 0;
}

.nota-confirmar .firma {
  font-size: 0.68rem;
}

/* --- MUSIC PLAYER (compacto a la derecha) --- */
.music-player {
  bottom: 14px;
  right: 14px;
  left: auto;
  padding: 4px 5px 4px 4px;
  gap: 6px;
  border-radius: 50px;
}

.mp-cover-wrapper {
  width: 38px;
  height: 38px;
}

.mp-title {
  max-width: 85px;
  font-size: 0.72rem;
}

.mp-artist {
  max-width: 85px;
  font-size: 0.6rem;
}

.mp-btn {
  width: 36px;
  height: 36px;
}

.mp-icon {
  width: 14px;
  height: 14px;
}

.mp-info {
  gap: 0;
}

/* --- FOOTER --- */
.footer {
  padding: 3.5rem 20px 2rem;
}

.footer-monogram svg {
  width: 80px;
  height: 80px;
}

.f-couple {
  font-size: clamp(1.8rem, 7vw, 2.4rem);
}

.f-date {
  font-size: 0.7rem;
  letter-spacing: 3px;
}

.f-hashtag {
  font-size: 0.8rem;
  letter-spacing: 1.5px;
}

.f-love {
  font-size: 1.2rem;
}

/* ============================================
   MÓVILES MUY PEQUEÑOS (≤ 380px)
   ============================================ */
@media (max-width: 380px) {
  .hero {
    padding: 60px 14px 50px;
  }

  .monogram svg {
    width: 100px;
    height: 100px;
  }

  .pretitle {
    font-size: 0.58rem;
    letter-spacing: 3px;
  }

  .couple {
    font-size: 2.1rem;
  }

  .couple .ampersand {
    font-size: 1.6rem;
  }

  .hero-date {
    font-size: 0.75rem;
    letter-spacing: 3px;
  }

  .verse {
    font-size: 0.88rem;
    padding: 0 4px;
  }

  .verse cite {
    font-size: 0.72rem;
  }

  .btn-gold {
    font-size: 0.64rem;
    padding: 0.6rem 1.2rem;
