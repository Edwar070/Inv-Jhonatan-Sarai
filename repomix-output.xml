  }

  .mp-cover-wrapper {
    width: 44px;
    height: 44px;
  }

  .mp-title {
    max-width: 120px;
    font-size: 0.78rem;
  }
  .mp-artist {
    max-width: 120px;
    font-size: 0.65rem;
  }
  .mp-btn {
    width: 40px;
    height: 40px;
  }
  .mp-icon {
    width: 17px;
    height: 17px;
  }

  /* Nota en tablet */
  .nota-confirmar {
    width: 70%;
    max-width: 340px;
    font-size: 0.78rem;
    padding: 14px 18px;
  }
}

/* ============================================
   TABLET GRANDE / LAPTOP PEQUEÑA (≥ 768px)
   ============================================ */
@media (min-width: 768px) {
  .container {
    max-width: 860px;
    padding: 0 32px;
  }

  .hero {
    padding: 90px 32px 80px;
  }

  .hero-inner {
    max-width: 640px;
    gap: 1rem;
  }

  .monogram svg {
    width: 160px;
    height: 160px;
  }

  .pretitle {
    font-size: 0.75rem;
    letter-spacing: 5px;
  }

  .hero-date {
    font-size: 1rem;
    letter-spacing: 6px;
  }

  /* Botones en desktop */
  .btn-gold {
    padding: 0.9rem 2.2rem;
    font-size: 0.75rem;
    min-height: 46px;
  }

  .btn-outline {
    padding: 0.65rem 1.8rem;
    font-size: 0.7rem;
    min-height: 40px;
  }

  .btn-wa {
    padding: 0.9rem 2.2rem;
    font-size: 0.75rem;
    min-height: 48px;
  }

  /* Eventos: 2 columnas */
  .event-grid {
    grid-template-columns: 1fr 1fr;
    max-width: 780px;
    gap: 2rem;
  }

  .event-card {
    padding: 2.75rem 2rem;
  }

  /* Countdown más grande */
  .counter {
    gap: 1rem;
  }

  .c-number {
    font-size: 2.6rem;
  }

  .c-box {
    padding: 0.9rem 0.6rem;
  }

  .c-item small {
    font-size: 0.7rem;
    letter-spacing: 3px;
  }

  /* Story más amplio */
  .story-text {
    font-size: 1.15rem;
    max-width: 560px;
  }

  .leaf-branch {
    max-width: 340px;
  }

  /* Footer más amplio */
  .footer-inner {
    max-width: 560px;
  }

  .footer-monogram svg {
    width: 110px;
    height: 110px;
  }
}

/* ============================================
   DESKTOP (≥ 1024px)
   ============================================ */
@media (min-width: 1024px) {
  .container {
    max-width: 960px;
  }

  .hero-inner {
    max-width: 720px;
  }

  .couple {
    font-size: 4.8rem;
  }

  .couple .ampersand {
    font-size: 3.6rem;
  }

  .leaf-corner {
    width: 160px;
    height: 160px;
    opacity: 0.55;
  }

  /* Mostrar indicador de scroll en desktop */
  .scroll-indicator {
    display: block;
  }

  .event-grid {
    max-width: 900px;
    gap: 2.5rem;
  }

  .story-text {
    font-size: 1.2rem;
    max-width: 620px;
  }
}

/* ============================================
   DESKTOP GRANDE (≥ 1280px)
   ============================================ */
@media (min-width: 1280px) {
  .container {
    max-width: 1040px;
  }

  .hero-inner {
    max-width: 800px;
  }
}

/* ============================================
   SOPORTE PARA NOTCH (iPhone X+)
   ============================================ */
@supports (padding: max(0px)) {
  .music-player {
    right: max(14px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
  }

  @media (min-width: 576px) {
    .music-player {
      right: max(24px, env(safe-area-inset-right));
      bottom: max(24px, env(safe-area-inset-bottom));
    }
  }

  .hero {
    padding-top: max(70px, env(safe-area-inset-top));
    padding-bottom: max(60px, env(safe-area-inset-bottom));
  }
}

/* ============================================
   ORIENTACIÓN LANDSCAPE EN TABLET/DESKTOP
   ============================================ */
@media (min-width: 768px) and (orientation: landscape) {
  .hero {
    min-height: 100vh;
    padding: 60px 40px 50px;
  }

  .hero-inner {
    gap: 0.75rem;
  }

  .monogram svg {
    width: 120px;
    height: 120px;
  }

  .couple {
    font-size: clamp(3rem, 5vw, 4rem);
  }
}

/* ============================================
   IMPRESIÓN
   ============================================ */
@media print {
  .music-player,
  .particles,
  .scroll-indicator,
  .leaf-corner,
  .btn-gold,
  .btn-outline,
  .btn-wa {
    display: none !important;
  }

  body {
    background: white;
    color: black;
  }

  .hero,
  .countdown,
  .story,
  .events,
  .dresscode,
  .gifts,
  .rsvp,
  .footer {
    padding: 20px;
    background: white !important;
    color: black !important;
    page-break-inside: avoid;
  }

  .reveal {
    opacity: 1 !important;
    transform: none !important;
  }
}
